# GameData asset the release APK downloads (public values, not secrets).
# Used by .github/workflows/android-release.yml. The knowledge bases live only on the fixed gamedata-channel Release (replaced in place by tools/publish_gamedata.ps1), so the URLs stay; a data release changes the SHA, commit, date and min build.
GAMEDATA_DB_URL=https://github.com/hhikr/ArkLores/releases/download/gamedata-channel/arklores_gamedata_zh.db.gz
GAMEDATA_DB_SHA256=94c07dbbdc039479fbf37613b911dac643005e2916fa0378722eb51f00ac77b4
# The ArknightsGameData commit that asset was made from and when that commit
# was made (GitHub's committer date): the app offers the asset over a knowledge
# base updated on the phone only when it is of the same or of newer game data.
GAMEDATA_DB_COMMIT=17759cc8cdf37388414145d16262a3a06f3ab25e
GAMEDATA_DB_COMMIT_DATE=2026-10-08T23:46:48Z
# Endfield knowledge base (0.12), built with tools/unpack_endfield.ps1.
ENDFIELD_DB_URL=https://github.com/hhikr/ArkLores/releases/download/gamedata-channel/arklores_endfield_zh.db.gz
ENDFIELD_DB_SHA256=fc34c31aaa531555e09c19f700ca7dc6a987a470af634cecaa8f9e32fdefb965
# Where the app looks for official knowledge bases uploaded after it was built
# (the channel file, written by tools/write_gamedata_channel.dart from this
# file and uploaded to the gamedata-channel Release with each data release),
# and the first app build that can install the assets above.
GAMEDATA_CHANNEL_URL=https://github.com/hhikr/ArkLores/releases/download/gamedata-channel/gamedata_channel.json
GAMEDATA_MIN_APP_BUILD=37
# Story art pack (0.20): portraits, backgrounds, CG and close-ups, one
# uncompressed SQLite file on the same Release. Only the channel file points at
# it (build 43 on); KB_COMMIT is the upstream commit of the knowledge base it
# was packed from.
STORY_ART_URL=https://github.com/hhikr/ArkLores/releases/download/gamedata-channel/arklores_story_art_zh.db
STORY_ART_SHA256=48b702bda869ddb656573150c7f06482380e0002d2be53e5ad214a6ee54aa28e
STORY_ART_SIZE=396136448
STORY_ART_KB_COMMIT=17759cc8cdf37388414145d16262a3a06f3ab25e
