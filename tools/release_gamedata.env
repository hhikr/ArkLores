# GameData asset the release APK downloads (public values, not secrets).
# Used by .github/workflows/android-release.yml; update with each data release.
GAMEDATA_DB_URL=https://github.com/hhikr/ArkLores/releases/download/v0.17.0/arklores_gamedata_zh.db.gz
GAMEDATA_DB_SHA256=1b9e3505cf10eb6b852fcbacfa412fd312a31e85986333d2e6d1cbcf7be8d004
# The ArknightsGameData commit that asset was made from and when that commit
# was made (GitHub's committer date): the app offers the asset over a knowledge
# base updated on the phone only when it is of the same or of newer game data.
GAMEDATA_DB_COMMIT=17759cc8cdf37388414145d16262a3a06f3ab25e
GAMEDATA_DB_COMMIT_DATE=2026-10-08T23:46:48Z
# Endfield knowledge base (0.12): the asset of the release to be created (built
# with tools/unpack_endfield.ps1; uploaded only when the developer releases).
ENDFIELD_DB_URL=https://github.com/hhikr/ArkLores/releases/download/v0.17.0/arklores_endfield_zh.db.gz
ENDFIELD_DB_SHA256=fc34c31aaa531555e09c19f700ca7dc6a987a470af634cecaa8f9e32fdefb965
# Where the app looks for official knowledge bases uploaded after it was built
# (the channel file, written by tools/write_gamedata_channel.dart from this
# file and uploaded to the gamedata-channel Release with each data release),
# and the first app build that can install the assets above.
GAMEDATA_CHANNEL_URL=https://github.com/hhikr/ArkLores/releases/download/gamedata-channel/gamedata_channel.json
GAMEDATA_MIN_APP_BUILD=37
